{
  "name": "a DISABLED version inside quarantine is held, not destroyed",
  "secrets": {
    "app-secrets": {
      "latest": 5,
      "versions": [
        {
          "version": 5,
          "state": "ENABLED"
        },
        {
          "version": 4,
          "state": "DISABLED"
        },
        {
          "version": 3,
          "state": "DISABLED"
        }
      ]
    }
  },
  "consumers": [
    {
      "kind": "service",
      "resource": "api",
      "secret": "app-secrets",
      "key": "latest"
    }
  ],
  "disabled_at": [
    {
      "secret": "app-secrets",
      "version": 4,
      "days_ago": 10
    },
    {
      "secret": "app-secrets",
      "version": 3,
      "days_ago": 10
    }
  ],
  "expect_disable": [],
  "expect_destroy": [],
  "expect_held": [
    "app-secrets:3",
    "app-secrets:4"
  ]
}
