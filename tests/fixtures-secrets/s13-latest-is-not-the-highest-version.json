{
  "name": "THE case a naive sweep gets wrong: the highest-numbered version is DISABLED, so `latest` resolves lower",
  "secrets": {
    "app-secrets": {
      "latest": 4,
      "versions": [
        {
          "version": 5,
          "state": "DISABLED"
        },
        {
          "version": 4,
          "state": "ENABLED"
        },
        {
          "version": 3,
          "state": "ENABLED"
        },
        {
          "version": 2,
          "state": "ENABLED"
        },
        {
          "version": 1,
          "state": "ENABLED"
        }
      ]
    }
  },
  "consumers": [
    {
      "kind": "service",
      "resource": "api",
      "secret": "app-secrets",
      "key": "latest"
    }
  ],
  "disabled_at": [
    {
      "secret": "app-secrets",
      "version": 5,
      "days_ago": 60
    }
  ],
  "expect_disable": [
    "app-secrets:1"
  ],
  "expect_destroy": [
    "app-secrets:5"
  ],
  "expect_held": []
}
