{
  "name": "each secret is planned against its own latest and its own consumers",
  "secrets": {
    "api-env": {
      "latest": 7,
      "versions": [
        {
          "version": 7,
          "state": "ENABLED"
        },
        {
          "version": 6,
          "state": "ENABLED"
        },
        {
          "version": 5,
          "state": "ENABLED"
        },
        {
          "version": 4,
          "state": "ENABLED"
        }
      ]
    },
    "issuer-env": {
      "latest": 2,
      "versions": [
        {
          "version": 2,
          "state": "ENABLED"
        },
        {
          "version": 1,
          "state": "DISABLED"
        }
      ]
    }
  },
  "consumers": [
    {
      "kind": "service",
      "resource": "api",
      "secret": "api-env",
      "key": "latest"
    },
    {
      "kind": "service",
      "resource": "issuer",
      "secret": "issuer-env",
      "key": "latest"
    }
  ],
  "disabled_at": [
    {
      "secret": "issuer-env",
      "version": 1,
      "days_ago": 5
    }
  ],
  "expect_disable": [
    "api-env:4"
  ],
  "expect_destroy": [],
  "expect_held": [
    "issuer-env:1"
  ]
}
