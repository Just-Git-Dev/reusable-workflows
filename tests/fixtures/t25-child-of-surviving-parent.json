{
  "name": "T25 — aged-out children of a surviving index are reported, not queued",
  "_comment": "The buildx shape: each tag is an index with an amd64 child and an attestation child. The children are untagged, so they trip the untagged rule, but GAR will not delete them while the parent index stands. Only the child whose parent is itself doomed may be queued.",
  "images": [
    { "package": "api", "version": "sha256:idx-new", "tags": ["v2.0.0"], "days_ago": 2 },
    { "package": "api", "version": "sha256:child-new-amd64", "tags": [], "days_ago": 2 },
    { "package": "api", "version": "sha256:idx-keep", "tags": ["v1.0.0"], "days_ago": 40 },
    { "package": "api", "version": "sha256:child-keep-amd64", "tags": [], "days_ago": 40 },
    { "package": "api", "version": "sha256:child-keep-attest", "tags": [], "days_ago": 40 },
    { "package": "api", "version": "sha256:idx-doomed", "tags": ["old-build"], "days_ago": 90 },
    { "package": "api", "version": "sha256:child-doomed-amd64", "tags": [], "days_ago": 90 },
    { "package": "api", "version": "sha256:orphan", "tags": [], "days_ago": 90 }
  ],
  "child_map": {
    "sha256:child-new-amd64": "sha256:idx-new",
    "sha256:child-keep-amd64": "sha256:idx-keep",
    "sha256:child-keep-attest": "sha256:idx-keep",
    "sha256:child-doomed-amd64": "sha256:idx-doomed"
  },
  "live_digests": ["sha256:idx-new"],
  "env": { "SHA_RETENTION_RELEASES": "0" },
  "expect_delete": [
    "api@sha256:child-doomed-amd64",
    "api@sha256:idx-doomed",
    "api@sha256:orphan"
  ],
  "expect_blocked": [
    "api@sha256:child-keep-amd64",
    "api@sha256:child-keep-attest"
  ]
}
