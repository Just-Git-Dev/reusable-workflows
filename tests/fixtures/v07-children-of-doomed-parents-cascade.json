      "tags": [
        "v1.0.0"
      ],
      "days_ago": 20
    },
    {
      "package": "api",
      "version": "sha256:rel1-amd64",
      "tags": [],
      "days_ago": 20
    },
    {
      "package": "api",
      "version": "sha256:rel1-attest",
      "tags": [],
      "days_ago": 20
    }
  ],
  "child_map": {
    "sha256:rel1-amd64": "sha256:rel1",
    "sha256:rel1-attest": "sha256:rel1"
  },
  "expect_delete": [
